{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["../../../src/lib/*"],
      "@data/*": ["../../../src/data/*"],
      "@hooks/*": ["../../../src/hooks/*"]
    }
  },
  "include": ["."]
}
