{
  "schemaVersion": "babyora-snart-autonomy-contract@1",
  "contractVersion": "snart-data-contract@1",
  "status": "locked_for_autonomous_implementation",
  "expectedNewCostNok": 0,
  "capabilities": {
    "family_sharing": false,
    "personal_calibration": false,
    "soon_preparation": false
  },
  "source": {
    "datasetName": "seNorge_2018",
    "sourceOrganization": "Meteorologisk institutt (MET Norway)",
    "normalPeriod": {
      "from": "1991-01-01",
      "through": "2020-12-31"
    },
    "years": [
      1991,
      1992,
      1993,
      1994,
      1995,
      1996,
      1997,
      1998,
      1999,
      2000,
      2001,
      2002,
      2003,
      2004,
      2005,
      2006,
      2007,
      2008,
      2009,
      2010,
      2011,
      2012,
      2013,
      2014,
      2015,
      2016,
      2017,
      2018,
      2019,
      2020
    ],
    "catalogUrl": "https://thredds.met.no/thredds/catalog/senorge/seNorge_2018/Archive/catalog.html",
    "catalogMachineUrl": "https://thredds.met.no/thredds/catalog/senorge/seNorge_2018/Archive/catalog.xml",
    "datasetUrlTemplate": "https://thredds.met.no/thredds/dodsC/senorge/seNorge_2018/Archive/seNorge2018_{YYYY}.nc",
    "variableVersions": {
      "rr": "23.11",
      "tg": "23.09",
      "tn": "23.09",
      "tx": "23.09"
    },
    "requiredVariables": [
      "latitude",
      "longitude",
      "rr",
      "tg",
      "time",
      "tn",
      "tx"
    ],
    "fillValue": -999.99,
    "licenseUriPolicy": "exact-uri-from-validated-das-metadata",
    "acceptedLicenseUris": [
      "https://www.met.no/en/free-meteorological-data/Licensing-and-crediting",
      "https://www.met.no/frie-meteorologiske-data/lisensiering-og-kreditering"
    ],
    "attributionText": "Historiske data: Meteorologisk institutt (MET Norway). Bearbeidet av Babyora.",
    "derivedDataDisclaimer": "Babyora-avledet 1991–2020-klimatologi basert på MET seNorge_2018 v23.09/v23.11; ikke et MET-varsel eller en offisiell MET-normal."
  },
  "homePlacePolicy": {
    "version": "home-place-key@1",
    "source": "src/data/no-cities.ts#NO_CITIES",
    "normalization": "Unicode-NFC; trim; collapse-Unicode-whitespace-to-U+0020; locale-independent-lowercase",
    "coordinateScale": 10000,
    "coordinateIntegerTolerance": 1e-8,
    "keyTemplate": "no-city:v1:${encodeURIComponent(nameKey)}:${latE4}:${lonE4}",
    "canonicalProjectionFields": [
      "homePlaceKey",
      "nameNfc",
      "latE4",
      "lonE4"
    ],
    "canonicalProjectionOrder": "homePlaceKey-UTF8-byte-order",
    "canonicalProjectionSha256": "c963c897d7e7c0db85da77cf57c1e10379b2a0bb567cc9051ab009e4c325e272",
    "currentExpectedCount": 60,
    "runtimeMatch": "exact-normalized-name-and-exact-latE4-lonE4",
    "fallback": "unavailable"
  },
  "gridPolicy": {
    "version": "nearest-grid-cell@1",
    "earthRadiusMetres": 6371008.8,
    "maxDistanceMillimetres": 5000000,
    "order": [
      "distanceMillimetres",
      "Y",
      "X"
    ],
    "distanceRounding": "half-away-from-zero",
    "invalidSelectedCell": "grid_invalid_or_sea",
    "tooFarReason": "grid_too_far",
    "neighbourFallback": false
  },
  "timePolicy": {
    "version": "met-utc-local-date@1",
    "timezone": "Europe/Oslo",
    "allowedUtcHours": [
      6,
      18
    ],
    "sourceInstantPattern": "YYYY-MM-DDTHH:00:00Z",
    "profileKeyFormat": "MM-DD",
    "profileKeyCount": 365,
    "leapDayPolicy": "map-target-02-29-to-02-28;discard-source-02-29",
    "rejectDuplicateVariableLocalDate": true
  },
  "derivationPolicy": {
    "version": "babyora-climate-derivation@1",
    "normalYears": [
      1991,
      2020
    ],
    "centeredWindowOffsets": [
      -2,
      -1,
      0,
      1,
      2
    ],
    "ringDays": 365,
    "expectedSamplesPerKey": 150,
    "minimumRepresentedYears": 27,
    "minimumValidSamples": 135,
    "quantileMethod": "Type-7",
    "quantileFormula": "h=(n-1)p+1;j=floor(h);gamma=h-j;q=x[j]+gamma*(x[j+1]-x[j])",
    "wetThresholdMillimetres": 1,
    "outputFields": [
      "p10MinC",
      "p50MeanC",
      "p90MaxC",
      "wetProbability"
    ],
    "rounding": {
      "distanceMillimetres": 0,
      "mode": "half-away-from-zero",
      "temperature": 1,
      "wetProbability": 4
    },
    "negativeZero": "normalize-to-zero",
    "exponentNotation": false,
    "compareHeuristicsBeforeRounding": true,
    "partialProfiles": false
  },
  "agePolicy": {
    "ageScopeMonths": [
      0,
      24
    ],
    "targetWindowDayOffsets": [
      28,
      42
    ],
    "targetWindowDayCount": 15,
    "calendarArithmetic": "Europe/Oslo-ISO-calendar-days",
    "eligibilityExpression": "targetEndLocalDate < addCalendarMonthsClamped(birthLocalDate,25)",
    "boundaryCases": {
      "twentyFiveMonthsAtD28": false,
      "twentyFiveMonthsAtD35": false,
      "twentyFiveMonthsAtD42": false,
      "twentyFiveMonthsAtD43": true
    },
    "crossBoundaryPayload": "ageEligibleForWholeWindow-only"
  },
  "httpPolicy": {
    "version": "met-thredds-http@1",
    "scheme": "https:",
    "hostname": "thredds.met.no",
    "allowedPorts": [
      "",
      "443"
    ],
    "allowUsername": false,
    "allowPassword": false,
    "allowHash": false,
    "pathPattern": "^/thredds/dodsC/senorge/seNorge_2018/Archive/seNorge2018_(199[1-9]|20(0[0-9]|1[0-9]|20))\\.nc\\.(dds|das|ascii)$",
    "allowedQueryVariables": [
      "latitude",
      "longitude",
      "rr",
      "tg",
      "time",
      "tn",
      "tx"
    ],
    "queryGrammar": "DAP2-variable-with-integer-slices-within-validated-DDS-dimensions",
    "userAgent": "klemeg/1.0 (sivertskotvold@gmail.com)",
    "redirect": "manual",
    "timeoutMilliseconds": 20000,
    "maxBodyBytes": {
      "coordinateGrid": 100663296,
      "metadataOrPoint": 2097152
    },
    "acceptedStatuses": [
      200
    ],
    "retryableStatuses": [
      429,
      500,
      502,
      503,
      504
    ],
    "maxAttempts": 3,
    "retryBackoffMilliseconds": [
      1000,
      2000
    ],
    "retryAfterFormats": [
      "delta-seconds",
      "IMF-fixdate"
    ],
    "retryAfterClampSeconds": [
      0,
      30
    ],
    "followRedirects": false,
    "cacheOnlyValidatedBodies": true,
    "maxConcurrentRequests": 1
  },
  "serializationPolicy": {
    "version": "canonical-json-utf8-lf@1",
    "objectKeyOrder": "lexicographic-UTF8-bytes",
    "arrayOrder": "preserve-contract-order",
    "encoding": "UTF-8",
    "lineEnding": "LF",
    "trailingNewline": true,
    "generatedAtCarriesIdentity": false
  },
  "privacyPolicy": {
    "formalReview": "deferred",
    "sessionOnly": true,
    "persistence": false,
    "analytics": false,
    "logging": false,
    "backendTransport": false,
    "runtimeClimateNetwork": false,
    "identifiers": false,
    "actionTimestamps": false
  },
  "reviewPolicy": {
    "maxCompleteAttempts": 3,
    "exhaustedStatus": "FAIL_REVIEW_CYCLES_EXHAUSTED",
    "forkTurns": "none",
    "candidateSchemaVersion": "snart-review-candidate@1",
    "receiptSchemaVersion": "codex-collaboration-review-receipt@1",
    "resultSchemaVersion": "snart-review-result@1",
    "requireDistinctReviewerAgentIds": true,
    "requireDistinctReviewerCanonicalTaskNames": true,
    "requireImplementerExclusion": true,
    "requirePassWithoutBlockerOrHigh": true,
    "immutableHashes": [
      "contractSha256",
      "evidenceSha256",
      "gitSha",
      "packSha256",
      "treeSha"
    ],
    "finalAnswerDigest": "SHA-256-exact-UTF8-payload",
    "transcriptDigest": "SHA-256-canonical-JSON-UTF8-LF-of-spawnRequest-spawnResult-finalEvent",
    "provenanceAuthenticated": false,
    "localReceiptsAreNotCryptographicProvenance": true
  },
  "publicationPolicy": {
    "buildTimeOnly": true,
    "outputReplacement": "atomic-after-complete-validation",
    "failedRefresh": "preserve-last-validated-committed-pack",
    "withoutValidatedPack": "capability-false-and-unavailable",
    "runtimeImportsTooling": false
  }
}
