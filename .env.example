# Klemeg env-variabler
# Kopier til .env.local og fyll inn faktiske verdier.
# Verdiene injekteres i Capacitor-bygget både av Codemagic og lokal build.

# ─── RevenueCat ──────────────────────────────────────────────
# Hent fra https://app.revenuecat.com/projects/klemeg/api-keys
# Hvis tomme: appen faller tilbake til localStorage-mock (trial-modus uten ekte kjøp).
VITE_REVENUECAT_PUBLIC_KEY_IOS=appl_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_REVENUECAT_PUBLIC_KEY_ANDROID=goog_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── met.no User-Agent (kun for produksjon) ──────────────────
# met.no krever User-Agent som identifiserer appen + kontakt-e-post.
# Lokalt fungerer det uten — Capacitor native HTTP setter dette via header.
VITE_METNO_USER_AGENT=klemeg/1.0 (sivertskotvold@gmail.com)

# ─── Apple Team (kun for Codemagic / lokal Xcode) ────────────
# IKKE i Vite-bundle — kun for native bygg-skript.
APPLE_TEAM_ID=PL9G26C26C
APP_BUNDLE_ID=no.klemeg.app

# ─── Gemini API (Nano Banana Pro = Gemini 3 Pro Image) ───────
# Kun for R8 avatar-produksjon (tools/avatar-gen/generate.ts). IKKE i Vite-bundle.
# Legg den faktiske nøkkelen i .env.local (gitignorert) — aldri her.
# Valgfritt: overstyr modell-ID med GEMINI_IMAGE_MODEL.
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# ─── Supabase babyora (eu-north-1) ───────────────────────────
# Project ref buwjclpcotsopxxdlmyp i org "Sivert Apper".
# Publishable key er trygt å committe i klient-bundle (RLS-styrt).
# Service-role key må ALDRI legges i .env.local — kun i Vercel-env for edge functions.
VITE_SUPABASE_URL=https://buwjclpcotsopxxdlmyp.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
