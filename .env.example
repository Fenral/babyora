# Snudly environment template
# Copy to .env.local for local overrides. Never commit .env.local.
# Every VITE_* value is embedded in the client bundle and must be treated as public.
# Empty optional values intentionally keep their integration in a safe no-op state.

# Native weather build
# Web uses the same-origin /api/forecast route. Capacitor needs an absolute URL.
VITE_FORECAST_PROXY=

# MET identification contract
# Contact-bearing, not a credential. The edge proxy currently has its own
# hard-coded User-Agent; TASK-013 must reconcile the two before release.
# This exact value is also pinned by the checked-in climate-pack contract.
VITE_METNO_USER_AGENT=klemeg/1.0 (sivertskotvold@gmail.com)

# RevenueCat public SDK keys
# Required only for real native purchases. Empty keys keep preview/web safe.
VITE_REVENUECAT_PUBLIC_KEY_IOS=
VITE_REVENUECAT_PUBLIC_KEY_ANDROID=

# PostHog EU analytics
# Empty key keeps analytics disabled. Host is explicit even though code has the same default.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.posthog.com

# Sentry — planned, not implemented yet
# DSN is public client configuration. Auth token is secret and CI-only.
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Supabase — deferred until family sharing is explicitly authorized
# Publishable key is client-visible and safe only together with tested RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional asset-generation tooling — never used by the shipped app
# GEMINI_API_KEY is secret and must stay only in .env.local or the invoking shell.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
